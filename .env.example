# Copy to .env and fill in. The real .env is ignored by Git. Server-side only: never use NEXT_PUBLIC_ for these.

# Resend (contact form, Get a Quote, Request a Sample): see libs/team-mail.js
RESEND_API_KEY=
# Sender; the domain must be verified in Resend. "name@domain" or "Name <name@domain>"
RESEND_FROM_EMAIL="Chempol Site <website@chempol.co.uk>"
# Main team inbox
CONTACT_TO_EMAIL=
# Optional CC list, comma-separated: a@x.com, b@y.com
CONTACT_CC_EMAILS=

# Atlantic Inquiry Manager: a copy of every contact / quote / sample / technical question, sent in the
# background (libs/inquiry-forward.js). Leave the key empty to switch forwarding off.
INQUIRY_API_URL=https://connect.atlanticgroup.ae/api/v1/submissions
INQUIRY_API_KEY=
# Protects /api/cron/inquiry-outbox (outbox status and manual retry). At least 16 random characters.
CRON_SECRET=
# Development only: also run the 1-minute retry timer under `next dev` (it always runs in production)
# INQUIRY_OUTBOX_IN_DEV=on
