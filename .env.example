# Copy to .env and fill in. The real .env is ignored by Git. Server-side only: never use NEXT_PUBLIC_ for these.

# Resend (contact form, Get a Quote, Request a Sample): see libs/team-mail.js
RESEND_API_KEY=
# Sender; the domain must be verified in Resend. "name@domain" or "Name <name@domain>"
RESEND_FROM_EMAIL="Chempol Site <website@chempol.co.uk>"
# Main team inbox
CONTACT_TO_EMAIL=
# Optional CC list, comma-separated: a@x.com, b@y.com
CONTACT_CC_EMAILS=
